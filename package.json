{
  "name": "scout-mib-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "bash scripts/check.sh",
    "tauri:debug": "tauri build --debug",
    "sandcastle:build-image": "podman build --build-arg UID=$(id -u) --build-arg GID=$(id -g) -t sandcastle/scout-mib-browser:local .sandcastle/",
    "sandcastle:run": "tsx .sandcastle/main.mts",
    "sandcastle:ticket": "tsx .sandcastle/main.mts",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:build": "cargo build --manifest-path src-tauri/Cargo.toml && bash scripts/test-e2e.sh"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/webdriverio": "^4.13.3",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/native-utils": "^2.6.0",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.3.0",
    "daisyui": "^5.7.16",
    "expect-webdriverio": "^5.7.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "svelte": "^5.20.1",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "overrides": {
    "@wdio/native-utils": "$@wdio/native-utils"
  }
}
